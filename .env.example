# RUNG environment template. Copy to .env and fill in. NEVER commit real values.
# Every value below is a PLACEHOLDER. Nothing here is a real account.

# --- Database (Postgres) ---
DATABASE_URL="postgresql://rung:rung_local_dev@localhost:5432/rung?schema=public"

# --- Object storage (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT="https://PLACEHOLDER.r2.cloudflarestorage.com"
S3_BUCKET="rung-dev"
S3_ACCESS_KEY_ID="PLACEHOLDER_NOT_REAL"
S3_SECRET_ACCESS_KEY="PLACEHOLDER_NOT_REAL"

# --- Auth ---
JWT_SECRET="change-me-local-dev-only"
OTP_PROVIDER="mock"            # mock | twilio | local_aggregator  (only mock works until an account exists)
OTP_PROVIDER_API_KEY="PLACEHOLDER_NOT_REAL"
SMS_SENDER_ID="RUNG"           # branded sender ID needs PTA registration via aggregator

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID="PLACEHOLDER_NOT_REAL"
WHATSAPP_ACCESS_TOKEN="PLACEHOLDER_NOT_REAL"

# --- Payments (sandbox only). See docs/PAYMENTS.md ---
# Mock test payment, cash on delivery and bank transfer always work. A wallet is switched on only when its
# values below are real (anything containing PLACEHOLDER keeps it off). None of these are real accounts.
PUBLIC_API_URL="http://localhost:4000"          # the API's public address; wallets post back to /api/v1/payments/callback/<wallet>
WEB_PUBLIC_URL="http://localhost:3000"          # customer website; customers land on /payment/result after paying
APP_RETURN_ORIGINS=""                           # extra places the app may return to besides rung:// (comma separated)
PAYMENT_SIMULATOR="0"                           # 1 = local fake wallet pages for tests. Ignored when NODE_ENV=production
JAZZCASH_MODE="sandbox"                         # sandbox | live (live only with Minahil's written go-ahead)
JAZZCASH_MERCHANT_ID="PLACEHOLDER_NOT_REAL"
JAZZCASH_PASSWORD="PLACEHOLDER_NOT_REAL"
JAZZCASH_INTEGRITY_SALT="PLACEHOLDER_NOT_REAL"
JAZZCASH_POST_URL="https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/"
EASYPAISA_MODE="sandbox"
EASYPAISA_STORE_ID="PLACEHOLDER_NOT_REAL"
EASYPAISA_HASH_KEY="PLACEHOLDER_NOT_REAL"       # 16 characters, from the Easypay merchant portal
EASYPAISA_BASE_URL="https://easypaystg.easypaisa.com.pk"
EASYPAISA_USERNAME="PLACEHOLDER_NOT_REAL"       # for the transaction inquiry API
EASYPAISA_PASSWORD="PLACEHOLDER_NOT_REAL"
EASYPAISA_ACCOUNT_NUM="PLACEHOLDER_NOT_REAL"
CARD_GATEWAY_KEY="PLACEHOLDER_NOT_REAL"         # card gateway not chosen yet; not built

# --- Business identity (fill ONLY with real registered details; never invent) ---
BUSINESS_LEGAL_NAME="PLACEHOLDER — company not registered yet"
BUSINESS_NTN="PLACEHOLDER — not issued yet"

# --- AI assistant (Milestone 9) ---
ANTHROPIC_API_KEY="PLACEHOLDER_NOT_REAL"
STT_PROVIDER="none"
TTS_PROVIDER="none"
