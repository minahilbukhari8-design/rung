{
  "name": "rung",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:validate": "pnpm --filter @rung/db prisma:validate",
    "db:migrate": "pnpm --filter @rung/db prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.33",
      "deepmerge-ts@<8": "^8.0.0"
    }
  }
}
